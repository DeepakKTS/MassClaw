# Turn an engine mismatch into an install failure instead of a warning.
#
# Without this, `npm ci` on Node 20 succeeded even though jsdom 30 declares
# `node: ^22.22.2 || ^24.15.0 || >=26.0.0`. The mismatch then surfaced much
# later and far less legibly: every jsdom test file died on import with
# `webidl.util.markAsUncloneable is not a function` from inside undici, and
# Vitest reported "no tests" rather than a version problem.
#
# The floor in package.json's `engines` is jsdom's, since it is the strictest
# dependency here. Bump both together.
engine-strict=true
