# Database
DATABASE_URL=postgresql+asyncpg://massclaw:massclaw@localhost:5432/massclaw
DATABASE_SYNC_URL=postgresql://massclaw:massclaw@localhost:5432/massclaw

# Redis
REDIS_URL=redis://localhost:6379

# Security
# REQUIRED: Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-use-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# Auth is enforced by default. Set to "false" for local development without auth.
# When true, JWT_SECRET_KEY must be set to a secure value (not the default).
AUTH_REQUIRED=false

# LLM Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Tool System
BRAVE_SEARCH_API_KEY=
TOOL_MAX_ITERATIONS=5
TOOL_CODE_TIMEOUT_SECONDS=30
TOOL_CODE_MEMORY_MB=256
TOOL_WORKSPACE_BASE=/tmp/massclaw/workspaces
TOOL_DOCKER_IMAGE=python:3.12-slim

# Agent Protocol
MCP_SERVER_ENABLED=true
MCP_CLIENT_ENABLED=true
AGENT_MESSAGE_TTL_SECONDS=3600
WEBSOCKET_AGENT_HEARTBEAT_SECONDS=30

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
# Set to "true" to allow requests through when Redis is down (default: reject with 503)
RATE_LIMIT_FAIL_OPEN=false

# Celery
CELERY_BROKER_URL=redis://localhost:6379/3
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# Health Check
HEALTH_CHECK_INTERVAL_SECONDS=60

# Trust
TRUST_DECAY_RATE=0.01
TRUST_DECAY_INTERVAL_HOURS=24
TRUST_LEARNING_RATE=0.3
TRUST_SCORE_WEIGHTS={"quality": 0.35, "speed": 0.15, "cost": 0.15, "consistency": 0.15, "reliability": 0.20}

# Memory
MEMORY_GC_INTERVAL_HOURS=6
MEMORY_DEFAULT_TTL_HOURS=168
MEMORY_FRESHNESS_DECAY_LAMBDA=0.01
MEMORY_MIN_SIMILARITY_THRESHOLD=0.5
